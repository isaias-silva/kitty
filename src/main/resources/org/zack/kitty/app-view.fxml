<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.control.TextArea?>
<VBox styleClass="main" alignment="CENTER" spacing="20.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.zack.kitty.controllers.AppController" stylesheets="@styles/main.css">
        <VBox>
              <Button styleClass="btn, config" text="⚙️" onAction="#onConfigClick"/>
        </VBox>

        <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
        </padding>


        <StackPane styleClass="profile">
                <ImageView fitWidth="250" fitHeight="250" preserveRatio="true">
                        <Image url="@assets/profile.png"/>
                </ImageView>
        </StackPane>

        <Button fx:id="micButton" text="🎙️" onAction="#onMicClick" styleClass="btn"/>
        <Pane styleClass="input-block">
            <TextArea fx:id="inputLabel" text="..." wrapText="true" prefRowCount="3"/>
                <Button text="perguntar" styleClass="submit"/>
        </Pane>



</VBox>