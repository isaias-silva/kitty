<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Separator?>

<VBox styleClass="main" alignment="TOP_CENTER" spacing="24.0"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.zack.kitty.controllers.ConfigController"
      stylesheets="@styles/main.css">

        <padding>
                <Insets top="40" right="40" bottom="40" left="40"/>
        </padding>

        <Separator styleClass="divider"/>


        <Label text="ASSISTENTE" styleClass="section-label"/>

        <VBox styleClass="field-group">
                <Label text="Nome do assistente" styleClass="field-label"/>
                <TextField fx:id="assistantName" promptText="Ex: Kitty"/>
        </VBox>


        <Label text="SPEECH TO TEXT" styleClass="section-label"/>

        <VBox styleClass="field-group">
                <Label text="Chave da API" styleClass="field-label"/>
                <TextField fx:id="sttKey" promptText="sk-..."/>
        </VBox>

        <VBox styleClass="field-group">
                <Label text="Modelo" styleClass="field-label"/>
                <TextField fx:id="sttModel" promptText="Ex: whisper-1"/>
        </VBox>


        <Label text="LARGE LANGUAGE MODEL" styleClass="section-label"/>

        <VBox styleClass="field-group">
                <Label text="Chave da API" styleClass="field-label"/>
                <TextField fx:id="llmKey" promptText="sk-..."/>
        </VBox>

        <VBox styleClass="field-group">
                <Label text="Modelo" styleClass="field-label"/>
                <TextField fx:id="llmModel" promptText="Ex: gpt-4o, claude-3"/>
        </VBox>

        <Separator styleClass="divider"/>


        <Button text="Salvar" styleClass="btn, save" onAction="#onSave" />

</VBox>